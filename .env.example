# Database
POSTGRES_PASSWORD=callmate_secret
DATABASE_URL=postgresql+asyncpg://callmate:callmate_secret@localhost:5432/callmate

# Redis
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI Whisper (local model, no API key needed)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
# Set to cuda for GPU: WHISPER_DEVICE=cuda

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_DURATION=2.5
AUDIO_STORAGE_PATH=/app/storage/audio

# Model Cache
MODEL_CACHE_PATH=/app/storage/models

# Encryption (AES-256 for audio files)
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Celery
CELERY_BROKER_URL=redis://:redis_secret@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret@localhost:6379/2

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
