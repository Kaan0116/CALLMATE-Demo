# Application
APP_NAME=CallMate AI
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://callmate:callmate123@localhost:5432/callmate_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=customer_profiles

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=tr

# Audio
AUDIO_CHUNK_SECONDS=3
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# NLP Model
NLP_MODEL=dbmdz/bert-base-turkish-cased
SENTIMENT_MODEL=savasy/bert-base-turkish-sentiment-cased

# Encryption (AES-256 for audio files)
AUDIO_ENCRYPTION_KEY=your-32-byte-encryption-key-here!

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=eu-central-1
S3_BUCKET_NAME=callmate-audio-recordings

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
